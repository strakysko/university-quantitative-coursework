Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Main", " ", "Function"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"runProgram", "[", "]"}], "  ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "averageWaitingTime", "}"}], ",", "\[IndentingNewLine]", 
      "\t\t\t\t\t\t\t", 
      RowBox[{
       RowBox[{"preliminaries", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\t\t\t\t\t\t\t", 
       RowBox[{"initialise", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\t\t\t\t", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Handle", " ", "events", " ", "when", " ", "the", " ", "time", " ", 
          "of", " ", "the", " ", "earliest", " ", "upcoming", " ", "event"}], 
         ",", " ", 
         RowBox[{
          RowBox[{"eventList", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{
         "occurs", " ", "before", " ", "the", " ", "end", " ", "of", " ", 
          "the", " ", "day"}], ",", " ", 
         RowBox[{"marked", " ", "by", " ", "numberOfHoursInADay"}]}], " ", 
        "*)"}], "\t\t\t\t", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"eventList", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", "numberOfDays"}], 
         ",", "\[IndentingNewLine]", "\t\t\t\t\t\t", "\[IndentingNewLine]", 
         "\t\t\t\t\t\t\t\t\t", 
         RowBox[{
          RowBox[{"handleNextEvent", "[", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "]"}],
        ";", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
       RowBox[{"report", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\t\t\t\t\t\t\t", 
       RowBox[{"averageWaitingTime", " ", "=", " ", 
        RowBox[{
        "totalWaitingTimeOfBoats", " ", "/", " ", "totalNumberOfArrivals"}]}],
        ";", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
       RowBox[{"{", 
        RowBox[{"averageWaitingTime", ",", " ", "longestWaitingTimeOfBoats"}],
         "}"}]}]}], "\[IndentingNewLine]", "\t\t\t", "]"}]}], 
   ";"}]}]], "Input",
