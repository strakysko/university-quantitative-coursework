Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Func", " ", "draws", " ", "from", " ", "the", " ", "Weibull", " ", 
    RowBox[{
     RowBox[{"distr", ".", " ", "w"}], "/", " ", "shape"}], " ", 
    RowBox[{"param", ".", " ", "beta_"}], " ", "and", " ", "scale", " ", 
    RowBox[{"param", ".", " ", "1"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"drawWeibullNumber", "[", "beta_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"RandomReal", "[", "]"}], "]"}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "beta"}], ")"}]}]}]}]], "Input",
