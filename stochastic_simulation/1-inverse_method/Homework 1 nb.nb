Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Find", " ", "maximum", " ", "of", " ", "func", " ", "z", 
    RowBox[{"(", "x", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"z", "[", "x_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"E", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", "*", " ", "Pi"}], "]"}]}], "*", 
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "/", "2"}], ")"}]}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "x"}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"c", " ", "=", " ", 
    RowBox[{
     RowBox[{"Maximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"z", "[", "x", "]"}], ",", 
         RowBox[{"x", ">", "0"}]}], "}"}], ",", "x"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.905605275483615*^9, 3.905605290013356*^9}, {
  3.905605357650612*^9, 3.905605460781585*^9}, {3.905605507722288*^9, 
