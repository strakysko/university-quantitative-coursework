Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Generates", " ", "n", " ", "samples", " ", "from", " ", "inverse", " ", 
     "Gaussian", " ", "using", " ", "A"}], "-", "R"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"z", "[", "x", "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "x"}], "/", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "x_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "x"}], "/", "2"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "X", "]"}], "<", "n"}], ",", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"samples", " ", "from", " ", "E", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], " ", "using", " ", "Inversion"}], 
       " ", "*)"}], "\n", 
      RowBox[{
       RowBox[{"Y", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", "2"}], "*", 
         RowBox[{"Log", "[", 
          RowBox[{"RandomReal", "[", "]"}], "]"}]}]}], ";", "\n", 
       RowBox[{"If", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "<=", 
          RowBox[{
           RowBox[{"f", "[", "Y", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "c", "*", 
             RowBox[{"g", "[", "Y", "]"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"X", ",", " ", "Y"}], "]"}], ";"}]}], " ", "]"}], " ", 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], " ", 
   "\[IndentingNewLine]"}]}]], "Input",
