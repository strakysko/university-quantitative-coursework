Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Func", " ", "draws", " ", "from", " ", "the", " ", "uniform", " ", 
     "distribution", " ", 
     RowBox[{"on", " ", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], ",", " ", 
    RowBox[{
    "using", " ", "a", " ", "standard", " ", "uniform", " ", "sample", " ", 
     "given", " ", "by", " ", "the", " ", "function", " ", 
     RowBox[{"RandomReal", "[", "]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"drawUniformNumber", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], "  ", ":=", " ", 
    RowBox[{"a", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}], " ", "*", " ", 
      RowBox[{"RandomReal", "[", "]"}]}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.905081667352458*^9, 3.9050816683682857`*^9}, {
  3.905082415462803*^9, 3.905082447128742*^9}, {3.905082618874617*^9, 
  3.905082619483324*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"7c314259-5f11-47cf-835e-26a0d1ad9be0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Func", " ", "draws", " ", "n", " ", "samples", " ", "of", " ", "U"}], 
     "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"U1", ",", " ", "U2"}], ")"}], " ", 
      RowBox[{"w", "/", " ", 
       RowBox[{"U1", "~", 
        RowBox[{"U", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}]}]}]}], ",", " ", 
    RowBox[{"U2", "~", 
     RowBox[{"U", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"drawTwoSamples", "[", "n_", "]"}], "  ", ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"drawUniformNumber", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"drawUniformNumber", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9051728470315347`*^9, 3.905172869589224*^9}, {
  3.905172904747367*^9, 3.9051729154824085`*^9}, {3.90517298292702*^9, 
  3.9051730776585217`*^9}, {3.9051732352310667`*^9, 3.905173304384054*^9}, {
  3.9051733653533773`*^9, 3.905173377403434*^9}, {3.905175019008704*^9, 
  3.905175021264439*^9}, {3.905175054824503*^9, 3.90517506975358*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"eb3e679b-c1de-4991-a5e0-23ae8f7eba3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Computes", " ", "numerically", " ", "given", " ", "sum", " ", "of", " ", 
    "n", " ", "summands"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", " ", "=", " ", "100000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U", " ", "=", " ", 
     RowBox[{"drawTwoSamples", "[", "n", "]"}]}], ";"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"4", "/", "n"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"U", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"U", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], " ", "\[LessEqual]",
          " ", "1"}], ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], " "}]}]}]], "Input",
 CellChangeTimes->{
  3.905082425740712*^9, {3.905082540640266*^9, 3.9050825481105337`*^9}, {
