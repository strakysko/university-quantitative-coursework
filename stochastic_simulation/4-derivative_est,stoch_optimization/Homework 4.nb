 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Outputs", " ", "the", " ", "central", " ", "difference", " ", "estimator",
     " ", "with", " ", "common", " ", "random", " ", "numbers", " ", 
    "D_\[CurlyEpsilon]", 
    RowBox[{"(", "\[Lambda]", ")"}], " ", "for", " ", "some", " ", 
    "\[CurlyEpsilon]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"centralDwithCRN", " ", "[", 
    RowBox[{"\[Lambda]_", ",", "\[CurlyEpsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "U", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "=", 
       RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"centralD", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"-", 
               RowBox[{"Log", "[", "U", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"\[Lambda]", "+", 
               RowBox[{"\[CurlyEpsilon]", "/", "2"}]}], ")"}]}], ")"}]}], "-", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"-", 
