Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Func", " ", "obtains", " ", 
     RowBox[{"the", " ", "'"}], 
     RowBox[{"real", "'"}], " ", "value", " ", "dz"}], "=", 
    RowBox[{
     RowBox[{"d", "/", "d\[Lambda]"}], " ", 
     RowBox[{"E", "[", 
      RowBox[{"2", "^", "X"}], "]"}], " ", "where", " ", 
     RowBox[{"X", "~", "Weibull"}], 
     RowBox[{"(", 
      RowBox[{"2", ",", "\[Lambda]"}], ")"}], " ", "evaluated", " ", "at", 
     " ", "\[Lambda]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"getTruedz", "[", "val_", "]"}], " ", ":=", " ", 
