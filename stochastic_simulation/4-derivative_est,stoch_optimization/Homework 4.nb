Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Func", " ", "outputs", " ", "the", " ", "central", " ", "difference", " ",
     "estimator", " ", "D_\[CurlyEpsilon]", 
    RowBox[{"(", "\[Lambda]", ")"}], " ", "for", " ", "some", " ", 
    "\[CurlyEpsilon]"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"centrallD", "[", 
     RowBox[{"\[Lambda]_", ",", "\[CurlyEpsilon]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "^", 
