         RowBox[{"\[Lambda]", "+", 
          RowBox[{"\[CurlyEpsilon]", "/", "2"}]}], "]"}]}], "-", 
       RowBox[{"2", "^", 
        RowBox[{"drawWeibull", "[", 
         RowBox[{"\[Lambda]", "-", 
          RowBox[{"\[CurlyEpsilon]", "/", "2"}]}], "]"}]}]}], ")"}], "/", 
     "\[CurlyEpsilon]"}]}], ";"}]}]], "Input",
