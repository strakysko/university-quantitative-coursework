         RowBox[{
          RowBox[{"2", "^", "x"}], " ", "2", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"x", "^", "2"}]}], " ", 
            RowBox[{"\[Lambda]", "^", "2"}]}], "]"}], "x", " ", 
          RowBox[{"\[Lambda]", "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
