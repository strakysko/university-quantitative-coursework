Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "finds", " ", "first", " ", "n", " ", "elements", " ", "of", " ", "the", 
    " ", "sequence", " ", "\[Theta]_n"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"find\[Theta]", "[", 
    RowBox[{"n_", ",", "\[Theta]0_", ",", "R_", ",", "C_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "\[Theta]", ",", "previous\[Theta]", ",", "next\[Theta]"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]", "=", 
       RowBox[{"{", "\[Theta]0", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"previous\[Theta]", "=", "\[Theta]0"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"While", "[", 
          RowBox[{"True", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"next\[Theta]", " ", "=", 
             RowBox[{"previous\[Theta]", "-", 
              RowBox[{
               RowBox[{"C", "/", "i"}], " ", 
               RowBox[{"dz", "[", 
                RowBox[{"previous\[Theta]", ",", "R"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"0", "<", "next\[Theta]", "<", "1"}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Theta]", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"\[Theta]", ",", "next\[Theta]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"previous\[Theta]", "=", "next\[Theta]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[Theta]"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
