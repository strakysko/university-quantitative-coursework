         RowBox[{"UniformDistribution", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "15"}], "/", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"Log", "[", 
              RowBox[{"1", "-", 
               RowBox[{"U", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "20"}], "}"}]}], "]"}]}], "-", "0.5"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Z", ",", "antitheticZ"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
