    " ", "with", " ", "antithetic", " ", "second", " ", "half"}], " ", "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"generateZ", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U", ",", "Z", ",", "antitheticZ"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "20"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Z", "=", 
       RowBox[{"CDF", "[", 
        RowBox[{
         RowBox[{"UniformDistribution", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "15"}], "/", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"Log", "[", 
              RowBox[{"U", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "20"}], "}"}]}], "]"}]}], "-", "0.5"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"antitheticZ", " ", "=", " ", 
       RowBox[{"CDF", "[", 
